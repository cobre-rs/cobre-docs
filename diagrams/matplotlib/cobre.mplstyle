# Cobre brand style for matplotlib
# Usage: plt.style.use('path/to/cobre.mplstyle')
# Or copy to ~/.config/matplotlib/stylelib/cobre.mplstyle

# --- Figure ---
figure.facecolor:     white
figure.edgecolor:     white
figure.dpi:           150
figure.figsize:       10, 6
figure.titlesize:     16
figure.titleweight:   600

# --- Font ---
font.family:          sans-serif
font.sans-serif:      IBM Plex Sans, DejaVu Sans, sans-serif
font.size:            11
mathtext.fontset:     cm

# --- Axes ---
axes.facecolor:       white
axes.edgecolor:       2D3440
axes.linewidth:       0.8
axes.grid:            True
axes.titlesize:       14
axes.titleweight:     600
axes.titlepad:        12
axes.labelsize:       12
axes.labelweight:     500
axes.labelpad:        8
axes.labelcolor:      333333
axes.spines.top:      False
axes.spines.right:    False

# --- Brand color cycle ---
# Order: Copper, Flow Blue, Patina, Spark Amber, Signal Red, Copper Dark, Copper Light
axes.prop_cycle:      cycler('color', ['B87333', '4A90B8', '4A8B6F', 'F5A623', 'DC4C4C', '8B5E3C', 'D4956A'])

# --- Grid ---
grid.color:           E0E0E0
grid.linewidth:       0.4
grid.alpha:           0.6
grid.linestyle:       -

# --- Lines ---
lines.linewidth:      2.0
lines.markersize:     6

# --- Ticks ---
xtick.direction:      out
ytick.direction:      out
xtick.labelsize:      10
ytick.labelsize:      10
xtick.color:          555555
ytick.color:          555555
xtick.major.width:    0.8
ytick.major.width:    0.8

# --- Legend ---
legend.fontsize:      10
legend.frameon:       True
legend.framealpha:    0.9
legend.fancybox:      True
legend.edgecolor:     DDDDDD

# --- Savefig ---
savefig.dpi:          200
savefig.bbox:         tight
savefig.pad_inches:   0.15
savefig.transparent:  False
